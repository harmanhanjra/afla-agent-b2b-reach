      "parameters": {
        "jsCode": "const x=$json.body ?? $json; const email=String(x.email||'').trim().toLowerCase(); const company=String(x.company||'').trim(); const need=String(x.need||x.message||'').trim(); const budget=Number(x.budget||0); if(!email || !email.includes('@')) throw new Error('valid email required'); let score=0; if(company) score+=20; if(need.length>=30) score+=35; if(budget>=500) score+=30; else if(budget>0) score+=15; if(/ai|automation|n8n|rag|agent|api|crm/i.test(need)) score+=15; score=Math.min(score,100); return [{json:{lead:{email,company,need,budget},score,qualified:score>=60,route:score>=60?'sales':'nurture',processedAt:new Date().toISOString()}}];"
      },
